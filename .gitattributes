# Binary payloads must never be line-ending converted.
* -text
*.exe binary
*.dll binary
*.dat binary
*.db binary
*.pak binary
*.bin binary
*.bmp binary
*.png binary
*.gif binary
*.jpg binary
*.ttf binary
*.woff binary
*.eot binary
*.swf binary
*.mxaddon binary
*.vsto binary
*.api binary
*.ini binary
# Text files keep stable line endings.
*.ps1 text eol=lf
*.cmd text eol=crlf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# GitHub rejects files over 100 MB, and libcef.dll is 137 MB.
8.10.8.0/libcef.dll filter=lfs diff=lfs merge=lfs -text
# Keep this Windows INI identical after a fresh checkout.
8.10.8.0/softs.ini text eol=crlf
